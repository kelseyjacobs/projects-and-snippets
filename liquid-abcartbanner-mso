{%- event evts | event_type: 'us_current_cart' | count: 10 -%}
{%- assign current_cart_evt = evts[0].us_current_cart -%}

{%- capture SKUs -%}
{%- assign cart_items = current_cart_evt.current_cart -%}
{%- assign cart_items = cart_items | uniq -%}

{%- assign valid_cart_items = "" -%}
{%- assign valid_count = 0 -%}

{%- for c_item in cart_items -%}

{%- assign p_resource_id = c_item -%}
{%- assign req_res_type = "product-us" -%}

{%- resources prods 
| filter: 'resource-id', '=', p_resource_id
| filter: 'resource-type', '=', req_res_type
| filter: 'recoeligible', '=', 'true'
| filter: 'ats', 'AFTER', '1'
-%}

{%- for prod in prods -%}

{%- assign z_res_id = prod.resource_id -%}
{%- assign z_res_type = prod.resource_type -%}

{%- if req_res_type == z_res_type -%}
{%- if p_resource_id == z_res_id -%}

{%- if valid_cart_items == "" -%}
{%- assign valid_cart_items = c_item -%}
{{ valid_cart_items | strip }}{% unless forloop.last and forloop.parentloop.last %},{% endunless %}
{%- else -%}
{%- assign valid_cart_items = valid_cart_items | append: "," | append: c_item -%}
{{ valid_cart_items | strip }}{% unless forloop.last and forloop.parentloop.last %},{% endunless %}
{%- endif -%}
{%- assign valid_count = valid_count | plus: 1 -%}
{%- endif -%}
{%- endif -%}
{%- endfor -%}
{%- endfor -%}
{%- endcapture -%}

{%- assign unique_SKUs_array = SKUs | split: "," | uniq -%}
{%- assign unique_SKUs_count = unique_SKUs_array | size -%}
{%- assign unique_SKUs_final = unique_SKUs_array | reverse | join: "," -%}

{%- global unique_SKUs = {{unique_SKUs_final}} -%}
{%- global int_unique_SKUs = unique_SKUs_final  -%}

{%- global unique_SKUs_count = {{unique_SKUs_count}} -%}
{%- global int_unique_SKUs_count = unique_SKUs_count  -%}

{%- assign pids = int_unique_SKUs | split: "," -%}


{%- if int_unique_SKUs_count >= 1 -%}
